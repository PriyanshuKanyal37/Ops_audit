# Copy this file to .env and fill in the values. Never commit .env.
# The phase each variable is first needed in is noted on the right.

# --- Phase 0 ---
DATABASE_URL=              # Neon console > project "ops-audit" > Connect > pooled connection string
ALLOWED_ORIGINS=http://localhost:3100   # comma-separated frontend origins (+ the Framer site later)

# --- Phase 1 ---
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=         # fallback website reader (optional: without it only Jina is used)
JINA_API_KEY=              # optional: Jina works without a key, at lower rate limits
CLAUDE_EFFORT=low          # low | medium | high. low was chosen after testing (see PLAN §5.1)
SESSION_SECRET=            # python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=              # python -c "import secrets; print(secrets.token_hex(16))"

# --- Phase 3 ---
TURNSTILE_SECRET_KEY=      # Cloudflare Turnstile secret. Local testing: 1x0000000000000000000000000000000AA (always passes)
DAILY_SPEND_CAP_USD=20     # Claude spend per UTC day; Slack alert at 80% and 100%
RATE_LIMIT_PER_HOUR=3      # audits per IP (PRD §9.4)
RATE_LIMIT_PER_DAY=10
SLACK_WEBHOOK_URL=         # Shiv's alert channel (empty = alerts only logged)

# --- Phase 4 ---
RESEND_API_KEY=
EMAIL_FROM=Ladder <audit@theladder.ai>
FRONTEND_URL=http://localhost:3100   # used to build report links in emails and Slack

# --- Phase 5 ---
JOBS_ENABLED=              # true in production only: runs the 48h follow-up email + 24h Slack alert every 10 min
PUBLIC_API_URL=http://localhost:8100  # this backend's public address; Shiv's feedback links in Slack point here
