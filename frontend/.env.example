# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser; none of these are secret.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.

NEXT_PUBLIC_API_URL=http://localhost:8100          # the FastAPI backend (8100 locally; 8000 is LadderFlow's)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                    # Phase 3: Cloudflare Turnstile site key
NEXT_PUBLIC_CALENDLY_URL=                          # Phase 4: booking link
NEXT_PUBLIC_CLIENT_ENGINE_URL=https://theladder.ai/client-engine
